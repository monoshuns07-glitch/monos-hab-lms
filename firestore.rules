rules_version = '2';

// ⚠⚠ ЭНЭ ФАЙЛ ОДОО КОДООС БАЙРШУУЛАГДДАГ (2026-09-09):
//     node tools/deploy-rules.js --key <үйлчилгээний-дансны-түлхүүр.json>
// Хэрэгсэл нь амьд дүрмийг ЭХЛЭЭД татаж хадгалаад (буцаахад), дараа нь
// энэ файлыг байршуулна. Консол дээр гараар тавих шаардлагагүй.
// ⚠ Шинэ цуглуулга нэмэх бүрд ЭНД мөр нэмээд байршуулна. Мартвал апп
// «N цуглуулга уншигдсангүй» гэж хэлээд дата харагдахгүй.
//
// 2026-09-09 — АЮУЛГҮЙ БАЙДЛЫН ЗАСВАР (аудитын №8, №9 + шинэ олдвор):
//   · Өмнө нь ажилтан ӨӨРИЙН users баримтын `role` талбарыг өөрчилж
//     АДМИН болох боломжтой байв (allow update: if isOwner). Одоо эзэн нь
//     role/department/position/email/uid/isActive-ийг ХӨНДӨЖ ЧАДАХГҮЙ.
//   · user_roles-ыг ажилтан бүр бичиж (өөрийгөө «албаны дарга» болгож)
//     чаддаг байв — одоо зөвхөн админ бичнэ.
//   · Ажилтан бүх kpi_* цуглуулгын баримтыг УСТГАЖ чаддаг байв — одоо
//     устгах эрх зөвхөн админд. Ажилтны бичдэг цуглуулга (аюул, санал,
//     мэдээлэл, ХН захиалга, kpi_state толь) хэвээр бичигдэнэ.
//   · users жагсаалтыг ажилтан бүтнээр уншдаг байв — одоо зөвхөн өөрийнхөө
//     баримт; жагсаалт админд. (Ажилтны жагсаалт аппад R2-оос ирдэг.)

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // Админ эсэх — users/{uid}.role == 'admin'.
    // ⚠ Бичилт тутамд НЭГ уншилт нэмнэ. Зөвхөн шаардлагатай газар ашигла.
    function isAdminUser() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Эзэн өөрийн баримтаа засахдаа ЭРХ, АЛБА, АЛБАН ТУШААЛ, И-МЭЙЛ, UID,
    // ИДЭВХИЙГ өөрчилж чадахгүй (нууц үг солисон туг гэх мэтийг л бичнэ).
    function ownerSafeUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'department', 'position', 'email', 'uid', 'isActive']);
    }

    // Хэрэглэгчийн профайл — ЗӨВХӨН өөрийнхөө баримт; жагсаалт админд.
    match /users/{uid} {
      allow get:    if isOwner(uid) || isAdminUser();
      allow list:   if isAdminUser();
      allow create: if isAdminUser() ||
        (isOwner(uid) &&
         (!('role' in request.resource.data) || request.resource.data.role == 'employee'));
      allow update: if isAdminUser() || (isOwner(uid) && ownerSafeUpdate());
      allow delete: if false;
    }

    // Эрхийн давхар бүртгэл (депthead/employee override) — зөвхөн админ бичнэ,
    // хүн бүр ЗӨВХӨН өөрийнхөө мөрийг уншина.
    match /user_roles/{email} {
      allow get:   if isAdminUser() ||
        (isAuth() && request.auth.token.email != null &&
         request.auth.token.email.lower() == email.lower());
      allow list:  if isAdminUser();
      allow write: if isAdminUser();
    }

    // Сургалтын контент — уншина: нэвтэрсэн бүгд; бичнэ: админ.
    match /chapters/{docId}  { allow read: if isAuth(); allow write: if isAdminUser(); }
    match /topics/{docId}    { allow read: if isAuth(); allow write: if isAdminUser(); }
    match /trainings/{docId} { allow read: if isAuth(); allow write: if isAdminUser(); }
    match /questions/{docId} { allow read: if isAuth(); allow write: if isAdminUser(); }
    match /videos/{docId}    { allow read: if isAuth(); allow write: if isAdminUser(); }

    // Сургалтын явц — ажилтан ЗӨВХӨН өөрийн явцыг бичнэ; админ бусдынхыг.
    match /training_progress/{docId} {
      allow read: if isAuth();
      allow create, update: if isAuth() &&
        (request.resource.data.userId == request.auth.uid || isAdminUser());
      allow delete: if isAdminUser();
    }

    // Шалгалтын дүн — үүссэний дараа ӨӨРЧЛӨГДӨХГҮЙ.
    match /exam_results/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Үйлдлийн бүртгэл — зөвхөн нэмнэ.
    match /activity_logs/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Мэдлэгийн сан — нэвтрээгүй зочинд ч харагдана (nohon-tulbur хуудас).
    match /knowledge_base/{docId} {
      allow read:  if true;
      allow write: if isAdminUser();
    }

    // Чатын өдрийн хэрэглээ — зөвхөн сервер (admin SDK) бичнэ.
    match /chat_usage/{docId} {
      allow read:  if isAuth();
      allow write: if false;
    }

    // Файлын каталог — байршуулсан хүн бүр мөр НЭМНЭ; засах/устгах админ.
    match /files/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAdminUser();
    }

    // ── ХАБЭА / KPI систем ────────────────────────────────────────────────
    // Үндсэн толь — ажилтны аюул/санал/мэдээлэл энд нэгддэг (хуучин зам).
    match /kpi_state/{docId} {
      allow read, create, update: if isAuth();
      allow delete: if isAdminUser();
    }
    match /kpi_risk_dashboards/{docId} {
      allow read, create, update: if isAuth();
      allow delete: if isAdminUser();
    }

    // Ажилтны ӨӨРӨӨ бичдэг бүртгэлүүд — нэмэх/засах бүгд, устгах админ.
    match /kpi_reports/{docId}     { allow read, create, update: if isAuth(); allow delete: if isAdminUser(); }
    match /kpi_hazards/{docId}     { allow read, create, update: if isAuth(); allow delete: if isAdminUser(); }
    match /kpi_suggestions/{docId} { allow read, create, update: if isAuth(); allow delete: if isAdminUser(); }
    match /kpi_hrorders/{docId}    { allow read, create, update: if isAuth(); allow delete: if isAdminUser(); }

    // Админ л бичдэг бүртгэлүүд (R2 үндсэн, энэ нь нөөц толь).
    match /kpi_risks/{docId}             { allow read: if isAuth(); allow write: if isAdminUser(); }
    match /kpi_tasks/{docId}             { allow read: if isAuth(); allow write: if isAdminUser(); }
    match /kpi_violations/{docId}        { allow read: if isAuth(); allow write: if isAdminUser(); }
    match /kpi_incidents/{docId}         { allow read: if isAuth(); allow write: if isAdminUser(); }
    match /kpi_notifications/{docId}     { allow read: if isAuth(); allow write: if isAdminUser(); }
    match /kpi_videoViews/{docId}        { allow read: if isAuth(); allow write: if isAdminUser(); }
    match /kpi_examResults/{docId}       { allow read: if isAuth(); allow write: if isAdminUser(); }
    match /kpi_firstAidChecks/{docId}    { allow read: if isAuth(); allow write: if isAdminUser(); }
    match /kpi_ppeObservations/{docId}   { allow read: if isAuth(); allow write: if isAdminUser(); }
    match /kpi_extTrainings/{docId}      { allow read: if isAuth(); allow write: if isAdminUser(); }
    match /kpi_extAttendance/{docId}     { allow read: if isAuth(); allow write: if isAdminUser(); }
    match /kpi_externalTrainings/{docId} { allow read: if isAuth(); allow write: if isAdminUser(); }
    match /kpi_miskillStats/{docId}      { allow read: if isAuth(); allow write: if isAdminUser(); }
    match /kpi_backup/{docId}            { allow read: if isAdminUser(); allow write: if isAdminUser(); }

    // Дээр заагаагүй бүхнийг хориглоно.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
