{
  "version": 2,
  "framework": null,
  "cleanUrls": false,
  "trailingSlash": true,
  "crons": [
    {
      "path": "/api/push-daily/",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/wk-escalate/",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/trn-digest/",
      "schedule": "0 1 25 * *"
    },
    {
      "path": "/api/exam-sync/",
      "schedule": "10 15 * * *"
    },
    {
      "path": "/api/r2-backup/",
      "schedule": "40 17 * * *"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/kpi/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/kpi/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/pwa-init.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(self), payment=(), usb=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/shalgalt/habea-exam.html",
      "destination": "/habea-exam.html",
      "permanent": false
    },
    {
      "source": "/shalgalt/habea-admin.html",
      "destination": "/habea-admin.html",
      "permanent": false
    },
    {
      "source": "/habea-urdchilsan.html",
      "destination": "/habea-exam.html?exam=urdchilsan",
      "permanent": false
    },
    {
      "source": "/habea-ankhan.html",
      "destination": "/habea-exam.html?exam=ankhan",
      "permanent": false
    },
    {
      "source": "/habea-eeljit.html",
      "destination": "/habea-exam.html?exam=davtan_eeljit",
      "permanent": false
    },
    {
      "source": "/habea-eeljit-bus.html",
      "destination": "/habea-exam.html?exam=davtan_eeljit_bus",
      "permanent": false
    },
    {
      "source": "/my-results.html",
      "destination": "/kpi/",
      "permanent": false
    },
    {
      "source": "/test.html",
      "destination": "/kpi/",
      "permanent": false
    }
  ],
  "functions": {
    "api/trn-digest.js": {
      "maxDuration": 60
    },
    "api/push-daily.js": {
      "maxDuration": 60
    },
    "api/wk-escalate.js": {
      "maxDuration": 60
    },
    "api/r2-backup.js": {
      "maxDuration": 60
    },
    "api/exam-sync.js": {
      "maxDuration": 60
    },
    "api/otp-verify.js": {
      "maxDuration": 30
    }
  }
}
